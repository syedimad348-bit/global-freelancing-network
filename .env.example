# Global Freelancing Network Environment Configuration

# Server & Ports
PORT=8000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Authentication & Security
JWT_SECRET=your-32-character-jwt-access-secret-here
JWT_REFRESH_SECRET=your-32-character-jwt-refresh-secret-here

# Database (MongoDB Atlas or Local MongoDB)
# Optional: the application automatically runs using live memory cache if MongoDB is offline
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/freelancing_db?retryWrites=true&w=majority

# Job Aggregation APIs
# Optional: Free sources (Remotive, RemoteOK, Arbeitnow, Jobicy, WeWorkRemotely) work out-of-the-box
RAPIDAPI_KEY=f2ea5188e5msh134673dfca5e4c0p1cc16ajsn2b3f40be1f7c

# AI Engine Service URL (FastAPI Python Service; backend uses port 8000)
AI_ENGINE_URL=http://localhost:8001/analyze-resume
JOB_TARGET_SIZE=800
THE_MUSE_MAX_PAGES=30

# WhatsApp Notification Integration (Phase 6)
# Optional: Set provider credentials for automatic dispatch of trick access details
# If unconfigured, access requests are safely queued and recorded in the database
WHATSAPP_PROVIDER=none
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Email SMTP Alerts (Optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
SMTP_FROM=notifications@globalfreelance.network
