{
  "services": {
    "frontend": {
      "root": "frontend/"
    },
    "backend": {
      "root": "backend/",
      "framework": "express",
      "bindings": [
        {
          "type": "service",
          "service": "ai-engine",
          "format": "url",
          "env": "AI_ENGINE_URL"
        }
      ]
    },
    "ai-engine": {
      "root": "ai-engine/",
      "framework": "fastapi",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}